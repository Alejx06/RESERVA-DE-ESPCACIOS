# Copia este archivo como ".env" (en la misma carpeta backend) y completa tus datos.
#   Windows (CMD o PowerShell):  copy .env.example .env
#   Mac / Linux:                 cp .env.example .env

PORT=3000
# Pon "production" cuando la aplicación esté publicada en internet (cookies seguras y sin datos de ejemplo).
# NODE_ENV=production
# Dirección pública (aparece en los correos). En tu computador no hace falta.
# APP_URL=https://reservas.midominio.com

# --- Conexión a MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Déjalo vacío si tu MySQL local no tiene contraseña; en otro caso, escribe la tuya en .env.
DB_PASSWORD=
# La base se crea sola si el usuario tiene permiso (si no, créala: CREATE DATABASE reservas;)
DB_NAME=reservas
# En un hosting suelen darte una sola URL; si la usas, reemplaza los datos de arriba:
# DATABASE_URL=mysql://usuario:clave@host:3306/nombre_base
# Algunos servicios de MySQL en la nube exigen conexión cifrada:
# DB_SSL=true

# --- Primera cuenta administrativa (se crea al arrancar si no existe) ---
EMAIL_DOMAIN=amigo.edu.co
BOOTSTRAP_ADMIN_EMAIL=admin@amigo.edu.co
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZA-ESTA-CLAVE-ANTES-DE-INICIAR

# --- Correo saliente (códigos de registro, confirmaciones y recordatorios) ---
# Ejemplo con Gmail (necesita verificación en 2 pasos y una "contraseña de aplicación"):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASSWORD=la-contraseña-de-aplicación-de-16-letras
# SMTP_FROM=Reservas Institucionales <tucuenta@gmail.com>
# Sin SMTP puedes probar todo imprimiendo los correos en la consola del servidor:
# MAIL_SIMULATE=true
# Minutos antes de la reserva en que se envía el recordatorio (por defecto 60)
# REMINDER_MINUTES_BEFORE=60

# --- Opcionales ---
# Para presentar fuera de 07:00 a 21:00:
# OPEN_HOUR=0
# CLOSE_HOUR=24
# Permitir reservar en horas ya pasadas (solo demos):
# ALLOW_PAST=true
